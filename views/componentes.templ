package views

import (
	"fmt"
	"strconv"
	"strings"
	"time"
)

// Aviso es el mensaje que se muestra arriba de la página (en negro; los de
// error llevan además una marca roja)
type Aviso struct {
	Texto string
	Error bool
}

templ AvisoMensaje(a Aviso) {
	if a.Texto != "" {
		<div class={ "mensaje", templ.KV("error", a.Error), templ.KV("ok", !a.Error) } role="status">{ a.Texto }</div>
	}
}

// VacioLista es el mensaje de una lista sin elementos
templ VacioLista(texto string) {
	<li class="vacio">{ texto }</li>
}

// IconoCategoria es el logo de cada categoría (SVG fijo de este archivo).
// Al pasar el cursor muestra el nombre de la categoría.
templ IconoCategoria(categoria string) {
	<span class="icono-categoria" aria-hidden="true" title={ categoria }>
		@templ.Raw(svgCategoria(categoria))
	</span>
}

// ErrorPage se usa para páginas inexistentes o accesos no permitidos
templ ErrorPage(p Pagina, mensaje string) {
	@Layout(p, contenidoError(p.Titulo, mensaje))
}

templ contenidoError(titulo string, mensaje string) {
	<section class="panel tarjeta-chica">
		<h2>{ titulo }</h2>
		<p>{ mensaje }</p>
		<a href="/" class="boton">Volver al inicio</a>
	</section>
}

// íconos de cada categoría (SVG simples de 24x24 que toman el color del texto)
var iconosCategoria = map[string]string{
	// televisor con el símbolo de "play"
	"Streaming": `<rect x="2" y="4" width="20" height="13" rx="2"/><path d="M8 21h8M12 17v4"/><path d="M10 8.5l5 2.5-5 2.5z"/>`,
	// nota musical
	"Música": `<path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>`,
	// computadora con código
	"Software": `<rect x="3" y="4" width="18" height="12" rx="1.5"/><path d="M1 20h22"/><path d="M10 8l-2 2 2 2M14 8l2 2-2 2"/>`,
	// pesa de gimnasio
	"Deportes": `<path d="M6 6v12M2.5 9v6M18 6v12M21.5 9v6M6 12h12"/>`,
	// corazón
	"Salud": `<path d="M12 20s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7.2a4.3 4.3 0 0 1 7.5 2.6C19.5 15.4 12 20 12 20z"/>`,
	// tarjeta
	"Financiero": `<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20M6 15h4"/>`,
	// globo terráqueo
	"Turismo": `<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"/>`,
	// cuatro cuadraditos
	"Otros": `<rect x="4" y="4" width="6.5" height="6.5" rx="1.5"/><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.5"/><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.5"/><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.5"/>`,
}

func svgCategoria(categoria string) string {
	trazos, ok := iconosCategoria[categoria]
	if !ok {
		trazos = iconosCategoria["Otros"]
	}
	return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">` + trazos + `</svg>`
}

// formatearMonto convierte "2500.00" en "$ 2.500,00"
func formatearMonto(monto string) string {
	valor, err := strconv.ParseFloat(monto, 64)
	if err != nil {
		return "$ " + monto
	}
	return "$ " + formatearNumero(valor)
}

func formatearNumero(valor float64) string {
	partes := strings.Split(fmt.Sprintf("%.2f", valor), ".")
	entero, decimales := partes[0], partes[1]

	signo := ""
	if strings.HasPrefix(entero, "-") {
		signo, entero = "-", entero[1:]
	}

	var miles []string
	for len(entero) > 3 {
		miles = append([]string{entero[len(entero)-3:]}, miles...)
		entero = entero[:len(entero)-3]
	}
	miles = append([]string{entero}, miles...)

	return signo + strings.Join(miles, ".") + "," + decimales
}

func formatearFecha(fecha time.Time) string {
	return fecha.Format("02/01/2006")
}
