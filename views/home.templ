package views

// HomePage es la portada pública, centrada en la pantalla
templ HomePage(p Pagina) {
	@Layout(p, contenidoHome(p.Sesion))
}

templ contenidoHome(sesion *Sesion) {
	<section class="portada">
		<h1>Suscripciones+</h1>
		<p class="lema">¡Todos tus servicios, en el mismo lugar!</p>
		<div class="acciones">
			if sesion == nil {
				<a href="/login" class="boton">Iniciar sesión</a>
				<a href="/registro" class="boton boton-claro">Registrarse</a>
			} else {
				<a href="/cuenta" class="boton">Ir a mi cuenta</a>
			}
		</div>
	</section>
}
