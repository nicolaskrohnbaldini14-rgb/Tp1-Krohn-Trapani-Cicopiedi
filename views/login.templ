package views

templ LoginPage(p Pagina, email string) {
	@Layout(p, contenidoLogin(email))
}

templ contenidoLogin(email string) {
	<section class="panel tarjeta-chica">
		<h2>Iniciar sesión</h2>
		<form method="post" action="/login" class="formulario">
			<label>
				Email
				<input type="email" name="email" value={ email } required autofocus/>
			</label>
			<label>
				Contraseña
				<input type="password" name="password" required/>
			</label>
			<button type="submit">Ingresar</button>
		</form>
		<p class="ayuda">¿No tenés cuenta? <a href="/registro">Registrate</a></p>
	</section>
}
