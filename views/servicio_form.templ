package views

import (
	"tp2-krohn-trapani-cicopiedi/db/sqlc"
	"tp2-krohn-trapani-cicopiedi/logic"
)

// EmpresaPage es el panel de las empresas: alta y baja de servicios del catálogo
templ EmpresaPage(sesion *Sesion, servicios []sqlc.Servicio, nombre string, mensajeError string) {
	@Layout("Mis servicios", sesion, contenidoEmpresa(sesion, servicios, nombre, mensajeError))
}

templ contenidoEmpresa(sesion *Sesion, servicios []sqlc.Servicio, nombre string, mensajeError string) {
	<h1>Hola, { sesion.Nombre }</h1>
	<p class="lema">Administrá el catálogo de servicios que ven los consumidores.</p>
	@AvisoError(mensajeError)
	<div class="grid panel">
		<article>
			<header>Nuevo servicio</header>
			@ServicioForm(nombre)
		</article>
		<article>
			<header>Catálogo de servicios</header>
			@ServicioList(servicios)
		</article>
	</div>
}

templ ServicioForm(nombre string) {
	<form method="post" action="/empresa/servicios">
		<label>
			Nombre
			<input type="text" name="nombre" value={ nombre } required/>
		</label>
		<label>
			Categoría
			<select name="categoria" required>
				for _, categoria := range logic.Categorias {
					<option value={ categoria }>{ categoria }</option>
				}
			</select>
		</label>
		<button type="submit">Crear servicio</button>
	</form>
}
