package views

import (
	"fmt"
	"strconv"

	"tp2-krohn-trapani-cicopiedi/db/sqlc"
)

// FormSuscripcion guarda lo que ingresó el usuario para no perderlo si hay un
// error (la contraseña de la cuenta no se vuelve a mostrar)
type FormSuscripcion struct {
	IDServicio       int32
	Monto            string
	FechaInicio      string
	FechaVencimiento string
	UsuarioCuenta    string
}

templ NuevaSuscripcionPage(p Pagina, form FormSuscripcion) {
	@Layout(p, contenidoNuevaSuscripcion(p.Servicios, form))
}

templ contenidoNuevaSuscripcion(servicios []sqlc.Servicio, form FormSuscripcion) {
	<h1>Nueva suscripción</h1>
	<section class="panel">
		@SuscripcionForm(servicios, form)
	</section>
	<p><a href="/cuenta/suscripciones">← Volver a mis suscripciones</a></p>
}

// SuscripcionForm crea una suscripción para el usuario que inició sesión
// (el usuario sale de la sesión y el estado inicial es siempre Activa)
templ SuscripcionForm(servicios []sqlc.Servicio, form FormSuscripcion) {
	if len(servicios) == 0 {
		<p class="vacio">Todavía no hay servicios disponibles.</p>
	} else {
		<form method="post" action="/cuenta/suscripciones" class="formulario formulario-grilla">
			<label>
				Servicio
				<select name="id_servicio" required>
					for _, grupo := range AgruparPorCategoria(servicios) {
						<optgroup label={ grupo.Categoria }>
							for _, s := range grupo.Servicios {
								<option value={ strconv.Itoa(int(s.IDServicio)) } selected?={ s.IDServicio == form.IDServicio }>{ s.Nombre }</option>
							}
						</optgroup>
					}
				</select>
				<a class="ver-catalogo" href={ templ.URL(fmt.Sprintf("/cuenta/suscripciones/nueva?catalogo=1&servicio=%d", form.IDServicio)) }>Elegir desde el catálogo</a>
			</label>
			<label>
				Monto mensual
				<input type="number" name="monto" min="0.01" step="0.01" value={ form.Monto } required autofocus?={ form.IDServicio != 0 }/>
			</label>
			<label>
				Fecha de inicio
				<input type="date" name="fecha_inicio" value={ form.FechaInicio } required/>
			</label>
			<label>
				Fecha de vencimiento
				<input type="date" name="fecha_vencimiento" value={ form.FechaVencimiento } required/>
			</label>
			<label>
				Usuario de la cuenta del servicio (opcional)
				<input type="text" name="usuario_cuenta" value={ form.UsuarioCuenta }/>
			</label>
			<label>
				Contraseña de la cuenta del servicio (opcional)
				<input type="password" name="password_cuenta"/>
			</label>
			<button type="submit">Crear suscripción</button>
		</form>
	}
}
