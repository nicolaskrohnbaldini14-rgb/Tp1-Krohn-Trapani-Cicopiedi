package views

import (
	"strconv"

	"tp2-krohn-trapani-cicopiedi/db/sqlc"
	"tp2-krohn-trapani-cicopiedi/logic"
)

templ SuscripcionForm(usuarios []sqlc.Usuario, servicios []sqlc.Servicio) {
	if len(usuarios) == 0 || len(servicios) == 0 {
		@MensajeVacio("Para crear una suscripción primero cargá al menos un usuario y un servicio.")
	} else {
		<form method="post" action="/suscripciones">
			<div class="grid">
				<label>
					Usuario
					<select name="id_usuario" required>
						for _, u := range usuarios {
							<option value={ strconv.Itoa(int(u.IDUsuario)) }>{ u.Nombre }</option>
						}
					</select>
				</label>
				<label>
					Servicio
					<select name="id_servicio" required>
						for _, s := range servicios {
							<option value={ strconv.Itoa(int(s.IDServicio)) }>{ s.Nombre } ({ s.Categoria })</option>
						}
					</select>
				</label>
				<label>
					Monto mensual
					<input type="number" name="monto" min="0.01" step="0.01" required/>
				</label>
			</div>
			<div class="grid">
				<label>
					Fecha de inicio
					<input type="date" name="fecha_inicio" required/>
				</label>
				<label>
					Fecha de vencimiento
					<input type="date" name="fecha_vencimiento" required/>
				</label>
				<label>
					Estado
					<select name="estado">
						for _, estado := range logic.Estados {
							<option value={ estado }>{ estado }</option>
						}
					</select>
				</label>
			</div>
			<div class="grid">
				<label>
					Usuario de la cuenta
					<input type="text" name="usuario_cuenta" required/>
				</label>
				<label>
					Contraseña de la cuenta
					<input type="password" name="password_cuenta" required/>
				</label>
			</div>
			<button type="submit">Crear suscripción</button>
		</form>
	}
}
