package views

import (
	"fmt"
	"strconv"

	"tp2-krohn-trapani-cicopiedi/db/sqlc"
)

templ MisSuscripcionesPage(sesion *Sesion, suscripciones []sqlc.ListSubscripcionesUsuarioRow, mensajeError string) {
	@Layout("Mis suscripciones", sesion, contenidoMisSuscripciones(suscripciones, mensajeError))
}

templ contenidoMisSuscripciones(suscripciones []sqlc.ListSubscripcionesUsuarioRow, mensajeError string) {
	<div class="titulo-con-accion">
		<h1>Mis suscripciones</h1>
		<a href="/cuenta/suscripciones/nueva" role="button">Nueva suscripción</a>
	</div>
	@AvisoError(mensajeError)
	<article>
		@SuscripcionList(suscripciones)
	</article>
}

// SuscripcionList muestra las suscripciones del usuario y su gasto mensual activo
templ SuscripcionList(suscripciones []sqlc.ListSubscripcionesUsuarioRow) {
	if len(suscripciones) == 0 {
		@MensajeVacio("Todavía no registraste ninguna suscripción.")
	} else {
		<p class="total">Gasto mensual activo: <strong>{ totalActivo(suscripciones) }</strong></p>
		<div class="overflow-auto">
			<table class="striped">
				<thead>
					<tr>
						<th>Servicio</th>
						<th>Monto</th>
						<th>Vigencia</th>
						<th>Cuenta</th>
						<th>Estado</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, s := range suscripciones {
						<tr>
							<td>
								{ s.ServicioNombre }
								<small class="etiqueta">{ s.ServicioCategoria }</small>
							</td>
							<td>{ formatearMonto(s.Monto) }</td>
							<td>{ formatearFecha(s.FechaInicio) } al { formatearFecha(s.FechaVencimiento) }</td>
							<td>{ s.UsuarioCuenta }</td>
							<td><span class={ "estado", "estado-" + s.Estado }>{ s.Estado }</span></td>
							<td>
								@BotonEliminar(fmt.Sprintf("/cuenta/suscripciones/%d/eliminar", s.IDSuscripcion))
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

// totalActivo suma los montos de las suscripciones en estado Activa
func totalActivo(suscripciones []sqlc.ListSubscripcionesUsuarioRow) string {
	total := 0.0
	for _, s := range suscripciones {
		if s.Estado != "Activa" {
			continue
		}
		if monto, err := strconv.ParseFloat(s.Monto, 64); err == nil {
			total += monto
		}
	}
	return "$ " + formatearNumero(total)
}
