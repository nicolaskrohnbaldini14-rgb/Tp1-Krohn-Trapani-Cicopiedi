package views

// DatosRegistro son los valores que se vuelven a mostrar si el alta falla
type DatosRegistro struct {
	Nombre string
	Email  string
}

templ RegistroPage(p Pagina, datos DatosRegistro) {
	@Layout(p, contenidoRegistro(datos))
}

templ contenidoRegistro(datos DatosRegistro) {
	<section class="panel tarjeta-chica">
		<h2>Crear cuenta</h2>
		@UsuarioForm(datos)
		<p class="ayuda">¿Ya tenés cuenta? <a href="/login">Iniciá sesión</a></p>
	</section>
}

// UsuarioForm es el formulario de alta de usuarios
templ UsuarioForm(datos DatosRegistro) {
	<form method="post" action="/registro" class="formulario">
		<label>
			Nombre
			<input type="text" name="nombre" value={ datos.Nombre } required/>
		</label>
		<label>
			Email
			<input type="email" name="email" value={ datos.Email } required/>
		</label>
		<label>
			Contraseña
			<input type="password" name="password" required/>
		</label>
		<button type="submit">Registrarme</button>
	</form>
}
