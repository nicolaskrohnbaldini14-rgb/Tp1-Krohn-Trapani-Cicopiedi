package views

import (
	"fmt"

	"tp2-krohn-trapani-cicopiedi/db/sqlc"
)

templ UsuarioList(usuarios []sqlc.Usuario) {
	if len(usuarios) == 0 {
		@MensajeVacio("Todavía no hay usuarios cargados.")
	} else {
		<div class="overflow-auto">
			<table class="striped">
				<thead>
					<tr>
						<th>Nombre</th>
						<th>Email</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, u := range usuarios {
						<tr>
							<td>{ u.Nombre }</td>
							<td>{ u.Email }</td>
							<td>
								@BotonEliminar(fmt.Sprintf("/usuarios/%d/eliminar", u.IDUsuario))
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}
